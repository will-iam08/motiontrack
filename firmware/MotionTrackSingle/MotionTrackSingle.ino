// ===== ExerciseFlow.h =====
// Tracks which phase of the workout this device is in and keeps it consistent
// with what the server reports. Arduino-free for host testing.


enum class Phase : uint8_t { None, BeforeBpm, Counting, AfterBpm, Done };

inline Phase parsePhase(const char* s) {
  if (!s) return Phase::None;
  if (strcmp(s, "before_bpm") == 0) return Phase::BeforeBpm;
  if (strcmp(s, "counting") == 0) return Phase::Counting;
  if (strcmp(s, "after_bpm") == 0) return Phase::AfterBpm;
  if (strcmp(s, "done") == 0) return Phase::Done;
  return Phase::None;
}

struct ServerWorkout {
  bool present;
  char id[37];
  bool reps;
  uint8_t exercise;  // 0..2
  uint16_t target;
  Phase phase;
  uint16_t repetitions;
  uint32_t lastSequence;
};

class ExerciseFlow {
 public:
  enum class Action : uint8_t { None, Reset, Follow, Ended };

  // counterTotal (required) is the rep counter's current running total; it anchors the
  // baseline when the server's repetition count is adopted (resume/follow).
  Action sync(const ServerWorkout& s, uint32_t counterTotal) {
    if (!s.present || s.phase == Phase::Done) {
      active_ = false;
      id_[0] = '\0';
      phase_ = Phase::None;
      return Action::Ended;
    }
    if (!active_ || strncmp(id_, s.id, sizeof(id_)) != 0) {
      strncpy(id_, s.id, sizeof(id_) - 1);
      id_[sizeof(id_) - 1] = '\0';
      active_ = true;
      target_ = s.target;
      phase_ = (s.phase == Phase::None) ? Phase::BeforeBpm : s.phase;
      reps_ = s.repetitions;
      if (target_ > 0 && reps_ > target_) reps_ = target_;
      setBaseline(counterTotal - reps_);
      entered_ = phase_;
      return Action::Reset;
    }
    target_ = s.target;
    if (rank(s.phase) > rank(phase_)) {
      phase_ = s.phase;
      if (s.repetitions > reps_) {
        reps_ = s.repetitions;
        if (target_ > 0 && reps_ > target_) reps_ = target_;
        setBaseline(counterTotal - reps_);
      } else if (phase_ == Phase::Counting) {
        setBaseline(counterTotal - reps_);
      }
      entered_ = phase_;
      return Action::Follow;
    }
    return Action::None;
  }

  // Returns reps this workout; frozen at target. Reaching target enters AfterBpm.
  uint16_t onRep(uint32_t counterTotal) {
    if (phase_ != Phase::Counting) return reps_;
    if ((int32_t)(counterTotal - baseline_) < 0) {
      // Counter total fell behind the baseline (reset/wrap): re-anchor, no rep.
      baseline_ = counterTotal - reps_;
      return reps_;
    }
    uint32_t n = counterTotal - baseline_;
    if (n > 0xFFFFu) n = 0xFFFFu;
    if (target_ > 0 && n >= target_) {
      reps_ = target_;
      phase_ = Phase::AfterBpm;
      entered_ = Phase::AfterBpm;
    } else {
      reps_ = (uint16_t)n;
    }
    return reps_;
  }

  // counterTotal re-baselines so reps detected during the check-in are not counted.
  void onBeforeBpmSaved(uint32_t counterTotal) {
    if (phase_ == Phase::BeforeBpm) {
      setBaseline(counterTotal - reps_);
      phase_ = Phase::Counting;
      entered_ = Phase::Counting;
    }
  }

  void onAfterBpmSaved() {
    if (phase_ == Phase::AfterBpm) phase_ = Phase::Done;
  }

  Phase phase() const { return phase_; }
  uint16_t reps() const { return reps_; }
  bool frozen() const { return target_ > 0 && reps_ >= target_; }
  void setBaseline(uint32_t counterTotal) { baseline_ = counterTotal; }

  // One-shot: the phase most recently entered (via Reset, Follow, a saved
  // before-BPM or reaching the target), or Phase::None if nothing new. The
  // sketch pushes a fresh status event for it.
  Phase takeEntered() {
    Phase p = entered_;
    entered_ = Phase::None;
    return p;
  }

 private:
  static uint8_t rank(Phase p) { return (uint8_t)p; }

  bool active_ = false;
  char id_[37] = {0};
  Phase phase_ = Phase::None;
  Phase entered_ = Phase::None;
  uint16_t target_ = 0;
  uint16_t reps_ = 0;
  uint32_t baseline_ = 0;
};

// ===== EventOutbox.h =====
// Small fixed-size queue of device events with stable sequence numbers so that
// uploads can be retried safely. Arduino-free for host testing.


enum class EventType : uint8_t { Status, BeforeBpm, Progress, AfterBpm };

struct OutEvent {
  EventType type;
  int value;
  uint8_t status;  // 0 waiting_finger, 1 reading, 2 weak_signal, 3 counting
  uint32_t sequence;
};

class EventOutbox {
 public:
  static const size_t Capacity = 16;

  void reset(uint32_t lastSequence) {
    head_ = 0;
    count_ = 0;
    headAssigned_ = false;
    nextSeq_ = lastSequence + 1;
    haveLastStatus_ = false;
    haveAcked_ = false;
  }

  // force: send a Status even if equal to the last pushed one (use on every phase entry).
  bool push(EventType type, int value, uint8_t status = 0, bool force = false) {
    if (type == EventType::Status) {
      if (!force && haveLastStatus_ && lastStatus_ == status) return true;
    } else if (type == EventType::Progress && count_ > 0) {
      size_t tail = count_ - 1;
      bool tailSent = (tail == 0 && headAssigned_);
      OutEvent& t = at(tail);
      if (!tailSent && t.type == EventType::Progress) {
        t.value = value;
        return true;
      }
    }
    if (count_ == Capacity) {
      size_t victim = findUnsent(EventType::Status);
      if (victim == Capacity) victim = findUnsent(EventType::Progress);
      if (victim == Capacity) return false;
      if (at(victim).type == EventType::Status) haveLastStatus_ = false;
      removeAt(victim);
    }
    OutEvent& e = at(count_);
    e.type = type;
    e.value = value;
    e.status = status;
    e.sequence = 0;
    count_++;
    if (type == EventType::Status) {
      haveLastStatus_ = true;
      lastStatus_ = status;
    }
    return true;
  }

  // Oldest queued event; its sequence is assigned on first call and kept on retries.
  bool front(OutEvent& out) {
    if (count_ == 0) return false;
    if (!headAssigned_) {
      buf_[head_].sequence = nextSeq_++;
      headAssigned_ = true;
    }
    out = buf_[head_];
    return true;
  }

  void ack() {
    if (count_ == 0 || !headAssigned_) return;
    lastAcked_ = buf_[head_];
    haveAcked_ = true;
    pop();
  }

  // Discard the head without recording it as acknowledged.
  void drop() {
    if (count_ == 0) return;
    pop();
  }

  bool lastAcked(OutEvent& out) const {
    if (!haveAcked_) return false;
    out = lastAcked_;
    return true;
  }

  size_t size() const { return count_; }

 private:
  OutEvent& at(size_t i) { return buf_[(head_ + i) % Capacity]; }

  void pop() {
    head_ = (head_ + 1) % Capacity;
    count_--;
    headAssigned_ = false;
  }

  size_t findUnsent(EventType type) {
    for (size_t i = (headAssigned_ ? 1 : 0); i < count_; i++)
      if (at(i).type == type) return i;
    return Capacity;
  }

  void removeAt(size_t i) {
    for (size_t j = i; j + 1 < count_; j++) at(j) = at(j + 1);
    count_--;
  }

  OutEvent buf_[Capacity] = {};
  size_t head_ = 0;
  size_t count_ = 0;
  bool headAssigned_ = false;
  uint32_t nextSeq_ = 1;
  bool haveLastStatus_ = false;
  uint8_t lastStatus_ = 0;
  bool haveAcked_ = false;
  OutEvent lastAcked_ = {};
};

// Returns the JSON length, or 0 if it did not fit in buf.
inline size_t toJson(const OutEvent& e, char* buf, size_t len) {
  static const char* const kStatus[4] = {"waiting_finger", "reading", "weak_signal", "counting"};
  int n = 0;
  switch (e.type) {
    case EventType::Status:
      n = snprintf(buf, len, "{\"sequence\":%lu,\"event\":\"status\",\"capture_status\":\"%s\"}",
                   (unsigned long)e.sequence, kStatus[e.status < 4 ? e.status : 0]);
      break;
    case EventType::BeforeBpm:
      n = snprintf(buf, len, "{\"sequence\":%lu,\"event\":\"before_bpm\",\"bpm\":%d}",
                   (unsigned long)e.sequence, e.value);
      break;
    case EventType::Progress:
      n = snprintf(buf, len, "{\"sequence\":%lu,\"event\":\"progress\",\"repetitions\":%d}",
                   (unsigned long)e.sequence, e.value);
      break;
    case EventType::AfterBpm:
      n = snprintf(buf, len, "{\"sequence\":%lu,\"event\":\"after_bpm\",\"bpm\":%d}",
                   (unsigned long)e.sequence, e.value);
      break;
  }
  if (n < 0 || (size_t)n >= len) return 0;
  return (size_t)n;
}

// ===== LocalSession.h =====
// One workout persists through a BLE disconnect. Hardware samples advance ExerciseFlow.
struct LocalSession {
    workout::Stage resting = workout::Idle;
    uint8_t movement = 0, target = 0, before = 0, after = 0;
    uint32_t began = 0, elapsed = 0;
    bool timing = false;
    workout::Stage stage(const ExerciseFlow& f) const {
        if (!timing) return resting;
        switch (f.phase()) {
            case Phase::BeforeBpm: return workout::Before;
            case Phase::Counting: return workout::Counting;
            case Phase::AfterBpm: return workout::After;
            default: return workout::Complete;
        }
    }
    void finish(uint32_t now, bool completed) {
        elapsed = (now-began)/1000;
        resting = completed ? workout::Complete : workout::Stopped;
        timing = false;
    }
    bool start(ExerciseFlow& f, const workout::Command& c, uint32_t now) {
        if (timing || c.op!=1 || c.expected!=resting) return false;
        f = ExerciseFlow{};
        ServerWorkout s{};
        s.present = s.reps = true;
        s.id[0]='L';
        s.target = c.target;
        s.phase = Phase::BeforeBpm;
        f.sync(s,0);
        target=c.target; movement=c.movement;
        before=after=0; elapsed=0; began=now; timing=true;
        return true;
    }
    void command(ExerciseFlow& f, const workout::Command& c, uint32_t count, uint32_t now) {
        if (!timing || c.expected!=stage(f)) return;
        if (c.op==2) {
            finish(now,false);
        } else if (c.op==3 && f.phase()==Phase::BeforeBpm) {
            f.onBeforeBpmSaved(count);
        } else if (c.op==3 && f.phase()==Phase::AfterBpm) {
            f.onAfterBpmSaved(); finish(now,true);
        }
    }
    workout::Packet snapshot(const ExerciseFlow& f, uint32_t now, uint8_t flags, uint8_t capture) const {
        return workout::packet(stage(f),f.reps(),timing?(now-began)/1000:elapsed,movement,target,flags,before,after,capture);
    }
};

