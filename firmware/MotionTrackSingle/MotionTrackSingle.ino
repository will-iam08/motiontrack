// ===== RepCounter.h =====
class RepCounter {
 public:
  virtual ~RepCounter() = default;
  virtual bool update(float gx, float gy, float gz, const float accel[3], uint32_t nowMs) = 0;
  virtual void resetMotion(bool relearnAxis = false) = 0;
  virtual bool ready() const { return true; }

  uint32_t count() const { return count_; }
  bool shallowAttempt() const { return shallowAttempt_; }

 protected:
  static bool validSample(float gx, float gy, float gz, const float accel[3]) {
    return std::isfinite(gx) && std::isfinite(gy) && std::isfinite(gz) &&
           std::isfinite(accel[0]) && std::isfinite(accel[1]) && std::isfinite(accel[2]);
  }

  uint32_t count_ = 0;
  bool shallowAttempt_ = false;
};

// ===== GravityEstimate.h =====
// A gyro-driven estimate of world up in the sensor's coordinate frame.
class GravityEstimate {
 public:
  explicit GravityEstimate(float correctionSeconds) : correctionSeconds_(correctionSeconds) {}

  bool update(float gx, float gy, float gz, const float accel[3], float seconds) {
    magnitude_ = magnitude(accel);
    speed_ = std::sqrt(gx * gx + gy * gy + gz * gz);
    const bool accelUsable = magnitude_ >= 0.75f && magnitude_ <= 1.25f;
    if (!initialized_) {
      if (!accelUsable) return false;
      for (int i = 0; i < 3; ++i) up_[i] = accel[i] / magnitude_;
      initialized_ = true;
      return true;
    }

    // The world frame rotates by -omega as seen by the sensor.
    const float k = 0.0174533f * seconds;
    const float wx = gx * k, wy = gy * k, wz = gz * k;
    const float ux = up_[0] - (wy * up_[2] - wz * up_[1]);
    const float uy = up_[1] - (wz * up_[0] - wx * up_[2]);
    const float uz = up_[2] - (wx * up_[1] - wy * up_[0]);
    up_[0] = ux; up_[1] = uy; up_[2] = uz;
    if (accelUsable) {
      const float weight = seconds / (correctionSeconds_ + seconds) / (1.0f + speed_ / 90.0f);
      for (int i = 0; i < 3; ++i) up_[i] += weight * (accel[i] / magnitude_ - up_[i]);
    }
    normalize(up_);
    return true;
  }

  bool initialized() const { return initialized_; }
  void reset() { initialized_ = false; }
  const float* up() const { return up_; }
  float accelMagnitude() const { return magnitude_; }
  float gyroSpeed() const { return speed_; }

  static void normalize(float v[3]) {
    const float n = magnitude(v);
    if (n > 1e-6f) for (int i = 0; i < 3; ++i) v[i] /= n;
  }

 private:
  static float magnitude(const float v[3]) {
    return std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
  }

  const float correctionSeconds_;
  float up_[3] = {0, 0, 1};
  float magnitude_ = 0.0f, speed_ = 0.0f;
  bool initialized_ = false;
};

// ===== TiltRepCounter.h =====
// Counts reps by how far the limb tilts away from its resting position and
// back, not by how fast it moves, so slow, careful reps from older patients
// count while half reps, tremor, arm swing and strap adjustments do not.
//
// Orientation: a complementary filter. The gyro rotates the estimated "up"
// direction every sample (smooth, no lag during a lift); the accelerometer
// pulls it back toward gravity over about half a second (no long-term drift).
// Samples where the limb's own acceleration distorts gravity (outside
// 0.75-1.25 g) only use the gyro.
//
// Measure each lift from its own lowest angle. Count after a return near rest
// and use the first completed rep to learn the lift direction.
class TiltRepCounter : public RepCounter {
 public:
  static constexpr float kAttemptTilt = 12.0f;     // degrees from the bottom that start an attempt
  static constexpr float kShallowFloor = 15.0f;    // an attempt this high but under the minimum is "shallow"
  static constexpr float kRestTilt = 6.0f;         // degrees from the bottom that end an attempt
  static constexpr float kStillStep = 2.0f;        // degrees per 250 ms window that still counts as still
  static constexpr uint32_t kMinRepMs = 500;
  static constexpr uint32_t kMinReturnMs = 100;
  static constexpr uint32_t kReanchorMs = 3000;    // still this long below the minimum: new resting position
  static constexpr uint32_t kGiveUpMs = 20000;     // held up this long without returning: new resting position
  static constexpr float kFilterSeconds = 0.4f;    // accelerometer correction time constant

  TiltRepCounter(float minimumTilt, float returnTilt) : minimumTilt_(minimumTilt), returnTilt_(returnTilt) {}

  // Gyro in deg/s (bias already removed), accel in g, time in ms. Returns true
  // on the sample where a rep is counted.
  bool update(float gx, float gy, float gz, const float accel[3], uint32_t nowMs) override {
    shallowAttempt_ = false;
    const uint32_t dt = nowMs - lastMs_;
    lastMs_ = nowMs;
    if (!hasLast_) {
      hasLast_ = true;
      return false;
    }
    if (dt > 200 || !validSample(gx, gy, gz, accel)) {
      // A gap in the data: the orientation can no longer be trusted.
      resetMotion(false);
      hasLast_ = true;
      return false;
    }
    if (dt == 0) return false;
    const float seconds = dt / 1000.0f;

    // 1. Orientation.
    const bool hadUp = gravity_.initialized();
    if (!gravity_.update(gx, gy, gz, accel, seconds)) return false;
    if (!hadUp) {
      setRest(nowMs);
      return false;
    }
    const float *up = gravity_.up();

    // 2. Stillness, judged by how far "up" moved over the last 250 ms, which
    //    ignores the gyro's tremor and noise.
    if (nowMs - windowStartMs_ >= 250) {
      const bool stillWindow = angleBetween(up, windowUp_) <= kStillStep;
      if (stillWindow) {
        if (!still_) stillSinceMs_ = windowStartMs_;
        still_ = true;
      } else {
        still_ = false;
      }
      for (int i = 0; i < 3; ++i) windowUp_[i] = up[i];
      windowStartMs_ = nowMs;
    }
    // Still only if the last full window was still AND the limb has not moved
    // since it ended (otherwise the first moments of a slow lift would still
    // look still for up to 250 ms).
    const bool stillNow = still_ && angleBetween(up, windowUp_) <= kStillStep;
    const uint32_t stillMs = stillNow ? nowMs - stillSinceMs_ : 0;

    // 3. Measure travel from the bottom of this rep, with a return near rest.
    const float tilt = angleBetween(up, rest_);

    if (phase_ == Idle) {
      if (!attempting_ && tilt < bottomTilt_) bottomTilt_ = tilt;
      const float travel = tilt - bottomTilt_;
      if (!attempting_ && travel >= kAttemptTilt) {
        attempting_ = true;
        attemptStartMs_ = nowMs;
        attemptPeak_ = travel;
      }
      if (attempting_) {
        if (travel > attemptPeak_) attemptPeak_ = travel;
        if (travel >= minimumTilt_ && inLiftDirection() && (hasDirection_ || tiltAxis(direction_))) {
          phase_ = Raised;
          raisedSinceMs_ = nowMs;
        } else if (travel <= kRestTilt) {
          shallowAttempt_ = attemptPeak_ >= kShallowFloor && attemptPeak_ < minimumTilt_ && inLiftDirection();
          attempting_ = false;
          if (tilt < bottomTilt_) bottomTilt_ = tilt;
        }
      }
      // Follow slow posture changes while resting, and adopt a new resting
      // position after holding still elsewhere for a few seconds.
      if (phase_ == Idle && stillNow) {
        if (tilt < kAttemptTilt && stillMs >= 500) {
          const float w = seconds / (2.0f + seconds);
          for (int i = 0; i < 3; ++i) rest_[i] += w * (up[i] - rest_[i]);
          GravityEstimate::normalize(rest_);
        } else if (stillMs >= kReanchorMs) {
          setRest(nowMs);
        }
      }
      return false;
    }

    // Raised: wait for the return.
    if (tilt <= returnTilt_) {
      const bool longEnough = nowMs - attemptStartMs_ >= kMinRepMs && nowMs - raisedSinceMs_ >= kMinReturnMs;
      phase_ = Idle;
      attempting_ = false;
      bottomTilt_ = tilt;
      if (longEnough) {
        hasDirection_ = true;
        ++count_;
        return true;
      }
      return false;
    }
    if (stillNow && stillMs >= kGiveUpMs) setRest(nowMs);  // never came back: this is the new rest
    return false;
  }

  void resetMotion(bool relearnAxis = false) override {
    phase_ = Idle;
    attempting_ = false;
    shallowAttempt_ = false;
    hasLast_ = false;
    gravity_.reset();
    still_ = false;
    if (relearnAxis) hasDirection_ = false;
  }

 private:
  enum Phase { Idle, Raised };

  static float angleBetween(const float a[3], const float b[3]) {
    const float cx = a[1] * b[2] - a[2] * b[1];
    const float cy = a[2] * b[0] - a[0] * b[2];
    const float cz = a[0] * b[1] - a[1] * b[0];
    const float d = a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    return std::atan2(std::sqrt(cx * cx + cy * cy + cz * cz), d) * 57.29578f;
  }

  // The axis the limb turns about while leaving rest, as a unit vector.
  bool tiltAxis(float out[3]) const {
    const float *up = gravity_.up();
    out[0] = rest_[1] * up[2] - rest_[2] * up[1];
    out[1] = rest_[2] * up[0] - rest_[0] * up[2];
    out[2] = rest_[0] * up[1] - rest_[1] * up[0];
    const float n = std::sqrt(out[0] * out[0] + out[1] * out[1] + out[2] * out[2]);
    if (n < 1e-4f) return false;
    for (int i = 0; i < 3; ++i) out[i] /= n;
    return true;
  }

  // Lifts go one way about the joint; moving the other way from rest (for
  // example lowering from a raised resting position) is not a rep.
  bool inLiftDirection() const {
    if (!hasDirection_) return true;
    float axis[3];
    if (!tiltAxis(axis)) return false;
    return axis[0] * direction_[0] + axis[1] * direction_[1] + axis[2] * direction_[2] > 0.6f;  // within about 50 degrees of the learned axis
  }

  void setRest(uint32_t nowMs) {
    const float *up = gravity_.up();
    for (int i = 0; i < 3; ++i) rest_[i] = windowUp_[i] = up[i];
    windowStartMs_ = nowMs;
    phase_ = Idle;
    attempting_ = false;
    bottomTilt_ = 0.0f;
  }

  Phase phase_ = Idle;
  const float minimumTilt_;
  const float returnTilt_;
  GravityEstimate gravity_{kFilterSeconds};
  float rest_[3] = {0, 0, 1}, windowUp_[3] = {0, 0, 1}, direction_[3] = {0, 0, 0};
  uint32_t lastMs_ = 0, windowStartMs_ = 0, stillSinceMs_ = 0, attemptStartMs_ = 0, raisedSinceMs_ = 0;
  float bottomTilt_ = 0.0f, attemptPeak_ = 0.0f;
  bool hasLast_ = false, hasDirection_ = false, still_ = false, attempting_ = false;
};

// ===== WristRepCounter.h =====
// Track consecutive upward and downward strokes from the vertical acceleration.
class WristRepCounter : public RepCounter {
 public:
  explicit WristRepCounter(float minimumTravel) : minimumTravel_(minimumTravel) {}

  bool update(float gx, float gy, float gz, const float accel[3], uint32_t nowMs) override {
    shallowAttempt_ = false;
    const uint32_t dt = nowMs - lastMs_;
    lastMs_ = nowMs;
    if (!hasLast_) {
      hasLast_ = true;
      return false;
    }
    if (dt > 200 || !validSample(gx, gy, gz, accel)) {
      resetMotion();
      return false;
    }
    if (dt == 0) return false;
    const float seconds = dt / 1000.0f;
    if (!gravity_.update(gx, gy, gz, accel, seconds)) return false;
    const float *up = gravity_.up();
    const float verticalG = up[0] * accel[0] + up[1] * accel[1] + up[2] * accel[2];

    if (!ready_) {
      captureRest(verticalG, dt);
      return false;
    }

    // Follow slow bias changes without requiring a pause between strokes.
    restG_ += seconds / (4.0f + seconds) * (verticalG - restG_);
    const float acceleration = (verticalG - restG_) * 9.80665f;
    filteredAcceleration_ += seconds / (0.04f + seconds) * (acceleration - filteredAcceleration_);
    const float a = filteredAcceleration_;
    velocity_ = (velocity_ + a * seconds) / (1.0f + seconds / kVelocitySeconds);

    const bool quiet = std::fabs(a) < kQuietAccel && gravity_.gyroSpeed() < 22.0f;
    quietMs_ = quiet ? quietMs_ + dt : 0;

    if (lift_ > 0.0f && nowMs - raisedAtMs_ > kMaxTopPauseMs) lift_ = 0.0f;
    if (direction_ == 0) {
      if (quietMs_ >= kStopMs) velocity_ = 0.0f;
      const float absVelocity = std::fabs(velocity_);
      if (absVelocity < kStartSpeed || (a * velocity_) < 0.0f) return false;
      direction_ = velocity_ > 0.0f ? 1 : -1;
    }

    const float signedSpeed = velocity_ * direction_;
    const float signedAcceleration = a * direction_;
    strokeMs_ += dt;
    if (strokeMs_ > kMaxStrokeMs) {
      clearStroke();
      lift_ = velocity_ = 0.0f;
      return false;
    }

    if (signedSpeed > 0.0f) travel_ += signedSpeed * seconds;
    if (signedSpeed > peakSpeed_) peakSpeed_ = signedSpeed;
    accelerated_ |= signedAcceleration > kProofAccel && signedSpeed > 0.0f;
    braked_ |= signedAcceleration < -kProofAccel && peakSpeed_ >= kStartSpeed;

    const bool reversed = signedSpeed <= -kTurnSpeed;
    const bool stopped = quietMs_ >= kStopMs && (signedSpeed < peakSpeed_ * 0.55f || quietMs_ >= kLongPauseMs);
    if (!reversed && !stopped) return false;

    const uint32_t movingMs = strokeMs_ - (stopped && strokeMs_ >= quietMs_ ? quietMs_ : 0U);
    // Offset some of the damping on longer strokes before checking their range.
    const float range = travel_ * (1.0f + movingMs / (2000.0f * kVelocitySeconds));
    const int8_t direction = direction_;
    const bool valid = accelerated_ && braked_ && movingMs >= kMinStrokeMs && range >= kShallowFloor;
    clearStroke();
    if (reversed) {
      direction_ = -direction;
      accelerated_ = signedAcceleration < -kProofAccel;
    } else {
      velocity_ = 0.0f;
    }
    if (!valid) return false;

    if (direction > 0) {
      lift_ = range;
      raisedAtMs_ = nowMs;
      return false;
    }

    const float lift = lift_;
    if (lift < kShallowFloor || range < lift * 0.42f) return false;
    lift_ = 0.0f;
    if (range > lift * 3.8f) return false;
    if (lift < minimumTravel_ * 0.8f || range < minimumTravel_ * 0.68f ||
        lift + range < 2.0f * minimumTravel_) {
      shallowAttempt_ = true;
      return false;
    }
    ++count_;
    return true;
  }

  bool ready() const override { return ready_; }

  void resetMotion(bool = false) override {
    gravity_.reset();
    hasLast_ = ready_ = shallowAttempt_ = false;
    restMs_ = quietMs_ = 0;
    lift_ = filteredAcceleration_ = velocity_ = 0.0f;
    clearStroke();
  }

 private:
  static constexpr float kVelocitySeconds = 1.6f;
  static constexpr float kStartSpeed = 0.027f;       // m/s
  static constexpr float kTurnSpeed = 0.016f;
  static constexpr float kProofAccel = 0.085f;       // m/s²
  static constexpr float kQuietAccel = 0.135f;
  static constexpr float kShallowFloor = 0.027f;     // m
  static constexpr uint32_t kRestMs = 300;
  static constexpr uint32_t kStopMs = 190;
  static constexpr uint32_t kLongPauseMs = 480;
  static constexpr uint32_t kMinStrokeMs = 220;
  static constexpr uint32_t kMaxStrokeMs = 5500;
  static constexpr uint32_t kMaxTopPauseMs = 8000;

  void captureRest(float verticalG, uint32_t dt) {
    if (gravity_.gyroSpeed() > 20.0f || std::fabs(gravity_.accelMagnitude() - 1.0f) > 0.15f) {
      restMs_ = 0;
      return;
    }
    if (restMs_ == 0 || std::fabs(verticalG - restG_) > 0.035f) {
      restG_ = verticalG;
      restMs_ = dt;
      return;
    }
    restMs_ += dt;
    restG_ += static_cast<float>(dt) / restMs_ * (verticalG - restG_);
    ready_ = restMs_ >= kRestMs;
  }

  void clearStroke() {
    direction_ = 0;
    strokeMs_ = 0;
    travel_ = peakSpeed_ = 0.0f;
    accelerated_ = braked_ = false;
  }

  const float minimumTravel_;
  GravityEstimate gravity_{1.0f};
  uint32_t lastMs_ = 0, restMs_ = 0, strokeMs_ = 0, quietMs_ = 0, raisedAtMs_ = 0;
  float restG_ = 1.0f, filteredAcceleration_ = 0.0f, velocity_ = 0.0f;
  float travel_ = 0.0f, peakSpeed_ = 0.0f, lift_ = 0.0f;
  int8_t direction_ = 0;
  bool hasLast_ = false, ready_ = false, accelerated_ = false, braked_ = false;
};

